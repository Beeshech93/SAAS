# Copy to .env and fill in. Never commit real values.
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=wba
POSTGRES_PASSWORD=
POSTGRES_DB=wba
DATABASE_URL=postgresql://wba:CHANGE_ME@localhost:5432/wba?schema=public

# API
API_PORT=4000
# Generate with: openssl rand -hex 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Browser origin of the web app (CORS + cookies)
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Reverse proxies in front of the API (the Next.js server counts as 1) so rate limits use the real client IP.
TRUST_PROXY=1
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_AUTH_MAX=20

# Web -> API proxy target (server side only)
API_URL=http://localhost:4000

# WhatsApp (official Meta Cloud API). Per-business token + phone number id are entered in the
# dashboard (WhatsApp page) and stored encrypted; only app-level values live here.
# Token you choose and type into Meta's webhook setup (>= 8 chars)
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (App settings > Basic); used to verify webhook signatures
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Encrypts per-business WhatsApp tokens. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Billing: lets an owner switch plan WITHOUT payment. Dev/staging only; keep false in production.
BILLING_SELF_SERVICE=false

# AI assistant (Anthropic API). Leave empty to disable automatic replies.
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
